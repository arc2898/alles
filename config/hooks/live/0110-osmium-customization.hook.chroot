#!/bin/sh
# Apply the curated Osmium OS desktop layer to a live-build chroot.
# This hook is deliberately limited to non-secret, system-wide defaults.
set -eu

PROJECT=/live-build
OVERLAY="$PROJECT/config/osmium-overlay"
ASSETS="$PROJECT/assets"

[ -d "$OVERLAY" ] || { echo "Osmium overlay missing: $OVERLAY" >&2; exit 1; }
[ -d "$ASSETS" ] || { echo "Osmium assets missing: $ASSETS" >&2; exit 1; }

copy_tree() {
    src=$1
    dst=$2
    [ -d "$src" ] || return 0
    mkdir -p "$dst"
    cp -a "$src"/. "$dst"/
}

# System identity/defaults and the live-session user skeleton.
copy_tree "$OVERLAY/etc" /etc
copy_tree "$OVERLAY/usr/local" /usr/local
if [ -f "$OVERLAY/usr/lib/os-release" ]; then
    install -m 0644 "$OVERLAY/usr/lib/os-release" /usr/lib/os-release
fi
copy_tree "$OVERLAY/usr/share/pixmaps" /usr/share/pixmaps
copy_tree "$OVERLAY/usr/share/gnome-background-properties" /usr/share/gnome-background-properties
if [ -f "$OVERLAY/root/.zshrc" ]; then
    install -m 0644 "$OVERLAY/root/.zshrc" /root/.zshrc
fi

# Exact installed MacTahoe theme/icon assets. The corresponding upstream
# source trees remain under upstream/ for future rebuilds.
copy_tree "$ASSETS/themes" /usr/share/themes
copy_tree "$ASSETS/icons" /usr/share/icons

# Wallpaper catalog and image set.
install -d /usr/share/backgrounds/osmium
copy_tree "$ASSETS/wallpapers/osmium" /usr/share/backgrounds/osmium
install -m 0644 "$ASSETS/wallpapers/osmium.xml" \
    /usr/share/gnome-background-properties/osmium.xml

# Plymouth boot/shutdown theme and system-wide GNOME Shell extensions.
rm -rf /usr/share/plymouth/themes/osmium
copy_tree "$ASSETS/plymouth/osmium" /usr/share/plymouth/themes/osmium
copy_tree "$ASSETS/gnome-shell/extensions" /usr/share/gnome-shell/extensions
copy_tree "$ASSETS/osmium-runtime" /usr/share/osmium

# Ensure the DING subprocess launchers remain executable after packaging.
if [ -d /usr/share/gnome-shell/extensions/ding@rastersoft.com ]; then
    find /usr/share/gnome-shell/extensions/ding@rastersoft.com \
        -type f -name '*.js' -exec chmod 0755 {} +
fi

# Compile extension schemas and icon caches when the corresponding tools exist.
find /usr/share/gnome-shell/extensions -type d -name schemas \
    -exec glib-compile-schemas {} \; 2>/dev/null || true
for theme in /usr/share/icons/MacTahoe-dark /usr/share/icons/MacTahoe-light; do
    [ -d "$theme" ] && gtk-update-icon-cache -f -t "$theme" 2>/dev/null || true
done

# Rebuild the system defaults database after copying the dconf profile/db.
if command -v dconf >/dev/null 2>&1; then
    dconf update || true
fi

# Keep the selected Plymouth theme in the generated initramfs. A failure here
# is non-fatal for source review; the ISO build gate checks it explicitly.
if command -v plymouth-set-default-theme >/dev/null 2>&1; then
    plymouth-set-default-theme -R osmium || true
fi

exit 0
