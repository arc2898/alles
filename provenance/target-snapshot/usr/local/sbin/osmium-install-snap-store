#!/bin/sh
set -eu

# snapd is normally seeded by systemd on the first real boot. Wait for the
# core snap instead of trying to seed it from an offline chroot.
if snap list snap-store >/dev/null 2>&1; then
  exit 0
fi

# Retry the core snap explicitly; systemd provides the mount machinery that
# is unavailable when snapd is started manually from a chroot.
if ! snap list core >/dev/null 2>&1; then
  snap install core
fi

i=0
while ! snap list core >/dev/null 2>&1; do
  if [ "$i" -ge 180 ]; then
    echo 'Timed out waiting for snapd core seeding.' >&2
    exit 1
  fi
  i=$((i + 1))
  sleep 1
done

if [ "$(snap get core experimental.user-daemons 2>/dev/null || true)" != true ]; then
  snap set core experimental.user-daemons=true
fi
snap install snap-store --channel=stable
