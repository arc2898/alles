[Unit]
Description=Install Snap Store on first Osmium OS boot
After=network-online.target snapd.service snapd.seeded.service
Wants=network-online.target
Requires=snapd.service
ConditionPathExists=/usr/bin/snap

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/osmium-install-snap-store
TimeoutStartSec=600
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
