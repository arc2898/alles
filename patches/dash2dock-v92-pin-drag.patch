+    // Osmium OS patch: drop-to-pin. Lets users drag an app from the
+    // overview onto the dock to pin it (Shell favorites), and right-click
+    // handling lives in animator.js (renderer actors).
+    _pinDropAppId(source) {
+      try {
+        if (!source) return null;
+        if (Main.xdndHandler && source === Main.xdndHandler) return null;
+        const app = source.app;
+        if (app && typeof app.get_id === 'function') {
+          const id = app.get_id();
+          if (id) return id;
+        }
+        if (typeof source.id === 'string' && source.id.endsWith('.desktop')) {
+          return source.id;
+        }
+      } catch (e) {
+        // ignore malformed drag sources
+      }
+      return null;
+    }
+
+    handleDragOver(source) {
+      try {
+        // internal icon reorder drags are handled by the icons themselves
+        if (this._dragging) return false;
+        if (!this._pinDropAppId(source)) return false;
+        if (DND.DragState && DND.DragState.COPY_DROP !== undefined) {
+          return DND.DragState.COPY_DROP;
+        }
+      } catch (e) {
+        // ignore
+      }
+      return false;
+    }
+
+    acceptDrop(source) {
+      try {
+        if (this._dragging) return false;
+        const id = this._pinDropAppId(source);
+        if (!id) return false;
+        Fav.getAppFavorites().addFavorite(id);
+        return true;
+      } catch (e) {
+        // ignore
+      }
+      return false;
+    }
+
