+        // Osmium OS patch: right-click Pin/Unpin. The visible dock icons are
+        // renderer actors without menus, so wire pinning here. The app is
+        // resolved at click time since renderers are pooled and reused.
+        icon._renderer._dockIcon = icon;
+        if (!icon._renderer._pinMenuWired) {
+          icon._renderer._pinMenuWired = true;
+          const renderer = icon._renderer;
+          renderer._pinMenuManager = new PopupMenu.PopupMenuManager(renderer);
+          renderer.connect('button-press-event', (actor, evt) => {
+            try {
+              if (evt.get_button() !== 3) return Clutter.EVENT_PROPAGATE;
+              const ditem = actor._dockIcon;
+              const app =
+                ditem && ditem._appwell ? ditem._appwell.app : null;
+              const appId =
+                app && typeof app.get_id === 'function'
+                  ? app.get_id()
+                  : null;
+              if (!appId) return Clutter.EVENT_PROPAGATE;
+              let sysApp = null;
+              try {
+                sysApp = Shell.AppSystem.get_default().lookup_app(appId);
+              } catch (e) {
+                sysApp = null;
+              }
+              if (!sysApp) return Clutter.EVENT_PROPAGATE;
+              try {
+                if (renderer._pinMenu) renderer._pinMenu.destroy();
+              } catch (e) {
+                // ignore
+              }
+              renderer._pinMenu = null;
+              const favs = Fav.getAppFavorites();
+              const menu = new PopupMenu.PopupMenu(actor, St.Side.TOP);
+              renderer._pinMenu = menu;
+              Main.uiGroup.add_child(menu.actor);
+              const pinned = favs.isFavorite(appId);
+              const toggle = new PopupMenu.PopupMenuItem(
+                pinned ? 'Unpin from Dock' : 'Pin to Dock'
+              );
+              toggle.connect('activate', () => {
+                try {
+                  if (pinned) favs.removeFavorite(appId);
+                  else favs.addFavorite(appId);
+                } catch (e) {
+                  // ignore
+                }
+              });
+              menu.addMenuItem(toggle);
+              renderer._pinMenuManager.addMenu(menu);
+              menu.connect('open-state-changed', (m, open) => {
+                if (renderer._pinMenu === m) renderer._pinMenu = null;
+                if (!open) {
+                  try {
+                    renderer._pinMenuManager.removeMenu(menu);
+                  } catch (e) {
+                    // ignore
+                  }
+                  menu.destroy();
+                }
+              });
